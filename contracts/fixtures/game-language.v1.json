  "cases": [
    {
      "name": "missing_variable_falls_back_to_english",
      "env": {},
      "expect": {
        "language": "en",
        "steam": "english"
      }
    },
    {
      "name": "blank_variable_falls_back_to_english",
      "env": {
        "CURATED_LANGUAGE": "   "
      },
      "expect": {
        "language": "en",
        "steam": "english"
      }
    },
    {
      "name": "english",
      "env": {
        "CURATED_LANGUAGE": "en"
      },
      "expect": {
        "language": "en",
        "steam": "english"
      }
    },
    {
      "name": "spanish",
      "env": {
        "CURATED_LANGUAGE": "es"
      },
      "expect": {
        "language": "es",
        "steam": "spanish"
      }
    },
    {
      "name": "italian",
      "env": {
        "CURATED_LANGUAGE": "it"
      },
      "expect": {
        "language": "it",
        "steam": "italian"
      }
    },
    {
      "name": "trimmed_and_case_insensitive",
      "env": {
        "CURATED_LANGUAGE": " IT "
      },
      "expect": {
        "language": "it",
        "steam": "italian"
      }
    },
    {
      "name": "regional_tag_uses_exact_catalog_code",
      "env": {
        "CURATED_LANGUAGE": "pt-BR"
      },
      "expect": {
        "language": "pt-br",
        "steam": "brazilian"
      }
    },
    {
      "name": "underscore_separator",
      "env": {
        "CURATED_LANGUAGE": "pt_br"
      },
      "expect": {
        "language": "pt-br",
        "steam": "brazilian"
      }
    },
    {
      "name": "latin_american_spanish",
      "env": {
        "CURATED_LANGUAGE": "es-419"
      },
      "expect": {
        "language": "es-419",
        "steam": "latam"
      }
    },
    {
      "name": "regional_tag_falls_back_to_primary_subtag",
      "env": {
        "CURATED_LANGUAGE": "it-IT"
      },
      "expect": {
        "language": "it",
        "steam": "italian"
      }
    },
    {
      "name": "spain_regional_tag",
      "env": {
        "CURATED_LANGUAGE": "es-ES"
      },
      "expect": {
        "language": "es",
        "steam": "spanish"
      }
    },
    {
      "name": "alias_zh",
      "env": {
        "CURATED_LANGUAGE": "zh"
      },
      "expect": {
        "language": "zh-cn",
        "steam": "schinese"
      }
    },
    {
      "name": "alias_zh_hant",
      "env": {
        "CURATED_LANGUAGE": "zh-Hant"
      },
      "expect": {
        "language": "zh-tw",
        "steam": "tchinese"
      }
    },
    {
      "name": "alias_nb",
      "env": {
        "CURATED_LANGUAGE": "nb"
      },
      "expect": {
        "language": "no",
        "steam": "norwegian"
      }
    },
    {
      "name": "korean_steam_name_is_koreana",
      "env": {
        "CURATED_LANGUAGE": "ko"
      },
      "expect": {
        "language": "ko",
        "steam": "koreana"
      }
    },
    {
      "name": "steam_name_is_accepted",
      "env": {
        "CURATED_LANGUAGE": "italian"
      },
      "expect": {
        "language": "it",
        "steam": "italian"
      }
    },
    {
      "name": "steam_name_brazilian",
      "env": {
        "CURATED_LANGUAGE": "brazilian"
      },
      "expect": {
        "language": "pt-br",
        "steam": "brazilian"
      }
    },
    {
      "name": "unknown_language_falls_back_to_english",
      "env": {
        "CURATED_LANGUAGE": "klingon"
      },
      "expect": {
        "language": "en",
        "steam": "english"
      }
    },
    {
      "name": "unknown_regional_tag_falls_back_to_english",
      "env": {
        "CURATED_LANGUAGE": "xx-yy"
      },
      "expect": {
        "language": "en",
        "steam": "english"
      }
    }
  ]
}
